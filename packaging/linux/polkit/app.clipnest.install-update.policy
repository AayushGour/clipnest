<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Lets Clipnest's Settings -> General "Install Update" install a new clipnest
  .deb. org.freedesktop.policykit.exec.path binds this action to one fixed
  helper (packaging/linux/scripts/clipnest-install-update), which re-verifies the
  .deb's SHA-256 as root before apt-get installs it — replacing the previous
  `pkexec apt-get install <user-owned /tmp path>` (a check-then-use race).
-->
<policyconfig>
  <vendor>Clipnest</vendor>
  <vendor_url>https://github.com/AayushGour/clipnest</vendor_url>
  <icon_name>app.clipnest.Clipnest</icon_name>

  <action id="app.clipnest.install-update">
    <description>Install a Clipnest update</description>
    <message>Authentication is required to install the Clipnest update.</message>
    <icon_name>app.clipnest.Clipnest</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/clipnest/clipnest-install-update</annotate>
  </action>
</policyconfig>
