ClipnestApp/*.xcodeproj/
DerivedData/
# Release pipeline output (scripts/build.sh, sign.sh, notarize.sh,
# package_dmg.sh) — generated artifacts (.xcarchive, .app, .zip, .dmg,
# ExportOptions.plist), never committed. See scripts/*.sh (T35-T37).
build/
.superpowers/
archived-images/
.DS_Store

# Private release signing key — never commit (scripts/release-cert.sh)
release-cert/

# T-GLY1 spike tooling (tools/glyph-classifier/) — generated synthetic
# dataset (thousands of PNGs) and trained model artifacts, never committed;
# regenerate via GlyphDatasetGen/GlyphTrainer. See tools/glyph-classifier/
# Package.swift's header comment for why this tree is a standalone package,
# not part of ClipnestCore/ClipnestApp.
tools/glyph-classifier/.build/
tools/glyph-classifier/.swiftpm/
tools/glyph-classifier/dataset/
tools/glyph-classifier/dataset_smoke/
tools/glyph-classifier/output/
# Crops harvested from the user's real (sensitive) clipboard-history
# screenshots for T-GLY1's real-world evaluation — never committed, even
# though these particular crops are just single keyboard glyphs/fragments
# (see this task's return-to-senior-dev report for how they were sourced).
tools/glyph-classifier/real_eval_crops/

# Raw stress/profiling captures (sample dumps, harness runs). Regenerate with
# tools/stress-harness; the findings that matter live in .claude/logs/tester.md
# and the task board, not in 15k lines of raw stack traces.
.claude/logs/stress-artifacts/

# extension/test/*.test.js load extension/src/core/*.js via `imports.core.*`
# (mirroring how build.sh lays out a variant) -- test/core/ is a scratch copy
# for that, never a second source of truth. See extension/README.md's Tests
# section.
extension/test/core/
